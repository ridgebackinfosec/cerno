---
title: Cerno core schema
---
erDiagram
    datasets {
        INTEGER dataset_id PK
        TEXT dataset_name UK
        TEXT source_file_hash
        TIMESTAMP created_at
    }
    finding_sources {
        INTEGER source_id PK "1=nessus..5=agent"
        TEXT source_name UK
    }
    finding_types {
        TEXT finding_type_id PK "'nessus:57608' | 'burp:00200300' | 'agent:7'"
        INTEGER source_id FK
        TEXT finding_type_name
        INTEGER severity_int FK
        BOOLEAN has_metasploit
        REAL cvss3_score
        JSON cves
    }
    findings {
        INTEGER finding_id PK
        INTEGER dataset_id FK
        TEXT finding_type_id FK
        TEXT review_state "unreviewed|in_progress|done"
        TEXT review_notes
    }
    finding_affected_hosts {
        INTEGER fah_id PK
        INTEGER finding_id FK
        INTEGER host_id FK
        INTEGER port_number FK
        TEXT evidence
    }
    hosts {
        INTEGER host_id PK
        TEXT ip_address UK
        TEXT netbios_name
        TEXT fqdn
        TIMESTAMP first_seen "cross-dataset history"
        TIMESTAMP last_seen
    }
    ports {
        INTEGER port_number PK
        TEXT service_name
    }
    host_services {
        INTEGER host_service_id PK
        INTEGER dataset_id FK
        INTEGER host_id FK
        INTEGER port_number FK
        TEXT protocol
        TEXT svc_name
    }
    sessions {
        INTEGER session_id PK
        INTEGER dataset_id FK
        TIMESTAMP session_start
        TIMESTAMP session_end "NULL while open"
    }
    session_datasets {
        INTEGER session_id PK
        INTEGER dataset_id PK
    }

    datasets   ||--o{ findings               : "CASCADE"
    finding_types ||--o{ findings               : "shared across datasets"
    finding_sources ||--o{ finding_types        : "lookup"
    findings ||--o{ finding_affected_hosts : "CASCADE"
    hosts   ||--o{ finding_affected_hosts : "normalized"
    ports   ||--o{ finding_affected_hosts : "normalized"
    datasets   ||--o{ host_services          : "CASCADE"
    hosts   ||--o{ host_services          : ""
    ports   ||--o{ host_services          : ""
    datasets   ||--o{ sessions               : "CASCADE"
    sessions ||--o{ session_datasets         : "CASCADE (multi-dataset)"
    datasets   ||--o{ session_datasets          : "CASCADE"
